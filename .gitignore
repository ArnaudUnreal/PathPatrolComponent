# Versionné : Source/, Config/, Plugins/ (.uplugin, Source/ et Resources/ uniquement), .gitignore et le .uproject. Tout le reste est ignoré.
/*
!/.gitignore
!/*.uproject
!/Source/
!/Config/
!/Plugins/

# Dans Plugins/ : seulement le .uplugin et les dossiers Source/ et Resources/ de chaque plugin
/Plugins/**
!/Plugins/**/
!/Plugins/**/*.uplugin
!/Plugins/**/Source/**
!/Plugins/**/Resources/**
/Plugins/**/Binaries/
/Plugins/**/Intermediate/
